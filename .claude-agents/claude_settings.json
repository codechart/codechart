{
  "permissions": {
    "allow": [
      "Bash(claude *)",
      "Bash(node *)",
      "Bash(npm *)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude-agents/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude-agents/hooks/post-compact.sh"
          }
        ]
      }
    ]
  }
}
