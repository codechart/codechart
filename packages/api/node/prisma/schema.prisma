datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DiagramMetadata {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  positioning Float?
  description String?
  type        String?
  story       String?
  user        String?
  labels      Label[]
  projects    Project[]
  fileNames   FileName[]
}

model Label {
  id                Int             @id @default(autoincrement())
  content           String
  diagramMetadata   DiagramMetadata @relation(fields: [diagramMetadataId], references: [id])
  diagramMetadataId Int
}

model Project {
  id                Int             @id @default(autoincrement())
  content           String
  diagramMetadata   DiagramMetadata @relation(fields: [diagramMetadataId], references: [id])
  diagramMetadataId Int
}

model FileName {
  id                Int             @id @default(autoincrement())
  content           String
  diagramMetadata   DiagramMetadata @relation(fields: [diagramMetadataId], references: [id])
  diagramMetadataId Int
}
