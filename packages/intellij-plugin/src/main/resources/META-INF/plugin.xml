<idea-plugin>
    <id>ua.codechart.plugin.Webview</id>

    <name>CodeChart</name>

    <description>
        chart diagrams of your code using Covalent
    </description>

    <vendor email="info@use-covalent.com" url="https://use-covalent.com">CodeChart</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Codechart"
                    secondary="true" icon="AllIcons.General.Modified" anchor="bottom"
                    factoryClass="ua.haltentech.plugin.webview.WebviewToolwindowFactory"/>
        <notificationGroup id="Webview Notification Group"
                           displayType="BALLOON"
                           key="webview.notifications"/>
    </extensions>
    <actions>
        <action id="ua.haltentech.plugin.webview.actions.SendToWebviewFromEditorAction"
                class="ua.haltentech.plugin.webview.actions.SendToWebviewFromEditorAction"
                text="Add To Covalent"
                description="Add To Covalent">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <group id="ua.haltentech.plugin.webview.actions.ReplaceInCodeChartGroup"
               class="com.intellij.openapi.actionSystem.DefaultActionGroup"
               popup="true"
               text="Replace in Covalent">
            <add-to-group group-id="EditorPopupMenu"
                          anchor="after"
                          relative-to-action="ua.haltentech.plugin.webview.actions.SendToWebviewFromEditorAction"/>
            <action id="ua.haltentech.plugin.webview.actions.ReplaceInCodeChart"
                    class="ua.haltentech.plugin.webview.actions.SendToWebviewFromEditorAction"
                    text="Replace"/>
        </group>
        <action id="ua.haltentech.plugin.webview.actions.SendToWebviewFromProjectsAction"
                class="ua.haltentech.plugin.webview.actions.SendToWebviewFromProjectsAction"
                text="Add to Covalent"
                description="Add to Covalent">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="ua.haltentech.plugin.webview.actions.SendToWebViewRefreshAction"
                class="ua.haltentech.plugin.webview.actions.SendToWebViewRefreshAction"
                text="Refresh Covalent"
                description="Refresh Covalent">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="ua.haltentech.plugin.webview.actions.SendToWebviewFromUsagesAction"
                class="ua.haltentech.plugin.webview.actions.SendToWebviewFromUsagesAction"
                text="Add to Covalent Usages"
                description="Add to Covalent">
            <add-to-group group-id="UsageView.Popup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>