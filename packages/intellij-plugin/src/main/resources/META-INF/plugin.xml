<idea-plugin>
    <id>ua.codechart.plugin.Webview</id>

    <name>Cochart</name>

    <description>
        chart diagrams of your code using Cochart
    </description>

    <vendor email="info@cochart.dev" url="https://cochart.dev">Cochart</vendor>

    <depends>com.intellij.modules.platform</depends>

    <!--
      No <idea-version> element on purpose: the IntelliJ Platform Gradle Plugin's patchPluginXml
      injects since-build from build.gradle.kts and writes no until-build, which keeps the plugin
      installable on every future IDE release.
    -->

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Cochart"
                    secondary="true" icon="AllIcons.General.Modified" anchor="bottom"
                    factoryClass="ua.haltentech.plugin.webview.WebviewToolwindowFactory"/>
        <!--
          No key= attribute: the plugin ships no <resource-bundle> and no *.properties file, so a
          bundle key could never be resolved. The id doubles as the display name.
          Keep this id in sync with Util.NOTIFICATION_GROUP_ID.
        -->
        <notificationGroup id="Cochart Notifications"
                           displayType="BALLOON"/>
    </extensions>
    <actions>
        <action id="ua.haltentech.plugin.webview.actions.GetProjectPathAction"
                class="ua.haltentech.plugin.webview.actions.GetProjectPathAction"
                text="Get Project Path"
                description="Get project path">
        </action>
        <!--
          "Add to Cochart" / "Replace in Cochart" / "Add to Cochart Usages" were removed: they
          post clickedOnLine_ideEvent / clickedOnFile_ideEvent, which the current viewer
          (packages/mermaid-plugin, src/ide/bridge.ts) does not handle. They were silent no-ops.
          Restoring them requires viewer-side support first.
        -->
        <action id="ua.haltentech.plugin.webview.actions.SendToWebViewRefreshAction"
                class="ua.haltentech.plugin.webview.actions.SendToWebViewRefreshAction"
                text="Refresh Cochart"
                description="Refresh Cochart">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
