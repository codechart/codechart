{
  "name": "cochart-vscode-plugin",
  "displayName": "Cochart",
  "description": "Chart your code",
  "publisher": "Cochart",
  "version": "1.0.1-16.11.25-21.14",
  "_NOTE_UPDATE_VSIX_VERSION": "When updating the version above, also update the version in .github/workflows/build-artifacts.yml line ~50 (Build VS Code plugin step)",
  "icon": "favicon-16x16.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HaltenTech-Team/webview-vscode-extension"
  },
  "activationEvents": [
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "webview-plugin.sendLineToWebview",
        "title": "Add line to Cochart"
      },
      {
        "command": "webview-plugin.sendFileToWebview",
        "title": "Add file to Cochart"
      },
      {
        "command": "webview-plugin.openWebview",
        "title": "Open Cochart"
      },
      {
        "command": "webview-plugin.refreshWebview",
        "title": "Refresh Cochart"
      },
      {
        "command": "webview-plugin.replaceLineToWebview",
        "title": "Replace line in Cochart"
      },
      {
        "command": "webview-plugin.sendDiagramToWebview",
        "title": "Load diagram to Cochart"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "activeEditor",
          "command": "webview-plugin.sendLineToWebview",
          "alt": "webview-plugin.sendLineToWebview",
          "group": "cochart"
        },
        {
          "submenu": "cochart.submenu",
          "group": "cochart"
        }
      ],
      "explorer/context": [
        {
          "command": "webview-plugin.sendFileToWebview",
          "group": "navigation"
        },
        {
          "command": "webview-plugin.sendDiagramToWebview",
          "when": "resourceExtname == .cochart.json",
          "group": "navigation"
        },
        {
          "command": "webview-plugin.refreshWebview",
          "group": "2_workspace "
        }
      ],
      "cochart.submenu": [
        {
          "command": "webview-plugin.replaceLineToWebview",
          "title": "Replace line in Cochart"
        }
      ]
    },
    "submenus": [
      {
        "id": "cochart.submenu",
        "label": "Replace in Cochart"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.9.3",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "@vscode/vsce": "^2.15.0"
  }
}