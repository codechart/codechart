{
  "name": "cochart-vscode-plugin",
  "displayName": "Cochart",
  "description": "Chart your code",
  "publisher": "Cochart",
  "version": "1.0.6",
  "icon": "favicon-16x16.png",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HaltenTech-Team/webview-vscode-extension"
  },
  "activationEvents": [
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Cochart",
      "properties": {
        "cochart.viewerAddresses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "http://localhost:4300/index.html",
            "http://localhost:2901/web/index.html",
            "http://localhost:2900/web/index.html",
            "http://localhost:2800/web/index.html"
          ],
          "markdownDescription": "Addresses the panel tries, in order, until one answers. The first that responds is loaded.\n\nEach must point at the viewer page itself. On the API that is `/web/`; on a Vite dev server it is `/index.html`. Point this at a different port to test a viewer built from another worktree without reinstalling the extension."
        }
      }
    },
    "commands": [
      {
        "command": "webview-plugin.openWebview",
        "title": "Open Cochart"
      },
      {
        "command": "webview-plugin.refreshWebview",
        "title": "Refresh Cochart"
      },
      {
        "command": "webview-plugin.sendDiagramToWebview",
        "title": "Load diagram to Cochart"
      }
    ],
    "menus": {
      "explorer/context": [
        {"_comment": "DISABLED: Load diagram to Cochart - load/save feature disabled",
          "command": "webview-plugin.sendDiagramToWebview",
          "when": "resourceExtname == .cochart.json",
          "group": "navigation",
          "DISABLED": true
        },
        {
          "command": "webview-plugin.refreshWebview",
          "group": "2_workspace "
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.8.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}