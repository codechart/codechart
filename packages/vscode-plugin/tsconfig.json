{
	"compilerOptions": {
	  "target": "ES2022",
	  "module": "commonjs",
	  // TypeScript 6.0 requires rootDir to be explicit when the sources sit in a
	  // subfolder; without it ts-loader fails with TS5011.
	  "rootDir": "src",
	  "outDir": "dist",
	  "strict": true,
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "sourceMap": true,
	  // TypeScript 6.0 stopped auto-including node_modules/@types/*;
	  // packages providing globals must now be listed explicitly.
	  "types": [
		"node",
		"mocha"
	  ]
	},
	"include": [
	  "src/**/*.ts"
	]
  }